<Window x:Class="KrakenHubMultiRoblox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Multi Roblox Manager" Width="1180" Height="800"
        MinWidth="900" MinHeight="650" Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel><TextBlock Text="MULTI ROBLOX" FontSize="26" FontWeight="Bold"/><TextBlock Text="Windows instance manager" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel>
            <Border HorizontalAlignment="Right" Background="#10251E" BorderBrush="#1D5945" BorderThickness="1" CornerRadius="10" Padding="12,7">
                <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#23D18B" Margin="0,0,8,0"/><TextBlock Text="Manager Ready" Foreground="#6DE7B5"/></StackPanel>
            </Border>
        </Grid>
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal"><Button Content="▶  Launch All" Background="{StaticResource Accent}" Click="LaunchAll_Click"/><Button Content="■  Stop All" Click="StopAll_Click"/><Button Content="↻  Restart All" Click="RestartAll_Click"/><Button Content="▦  Arrange" Click="Arrange_Click"/></StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="Instances" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,8,0"/><ComboBox x:Name="InstanceCountBox" Width="80" SelectedIndex="3" SelectionChanged="InstanceCountBox_Changed"><ComboBoxItem>1</ComboBoxItem><ComboBoxItem>2</ComboBoxItem><ComboBoxItem>3</ComboBoxItem><ComboBoxItem>4</ComboBoxItem><ComboBoxItem>5</ComboBoxItem><ComboBoxItem>6</ComboBoxItem><ComboBoxItem>7</ComboBoxItem><ComboBoxItem>8</ComboBoxItem><ComboBoxItem>10</ComboBoxItem><ComboBoxItem>15</ComboBoxItem><ComboBoxItem>20</ComboBoxItem><ComboBoxItem>25</ComboBoxItem><ComboBoxItem>30</ComboBoxItem><ComboBoxItem>40</ComboBoxItem><ComboBoxItem>50</ComboBoxItem></ComboBox></StackPanel>
        </Grid>
        <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="14" Padding="12"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="InstancesPanel"/></ScrollViewer></Border>
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal"><TextBlock Text="Layout:" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/><Button Content="2 × 2" Click="Layout2_Click"/><Button Content="3 × 3" Click="Layout3_Click"/><Button Content="4 × 4" Click="Layout4_Click"/><Button Content="5 × 10" Click="Layout50_Click"/><TextBlock Text="Rows" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="16,0,5,0"/><TextBox x:Name="RowsBox" Text="2" Width="40" Padding="7,4"/><TextBlock Text="Cols" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,5,0"/><TextBox x:Name="ColsBox" Text="2" Width="40" Padding="7,4"/></StackPanel>
            <TextBlock x:Name="StatusText" Text="0 running" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
        </Grid>
        <Border Grid.Row="4" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,10,0,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="External Runner" VerticalAlignment="Center" FontWeight="SemiBold" Margin="4,0,14,0"/>
                <TextBox x:Name="RunnerPathBox" Grid.Column="1" Padding="9,6" Background="#0A0F1A" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"/>
                <Button Grid.Column="2" Content="Browse" Click="BrowseRunner_Click"/><Button Grid.Column="3" Content="Test Launch" Click="TestRunner_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>